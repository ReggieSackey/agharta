# =====================================================================
# AGHARTA environment template — copy to the right locations; no real
# credentials are committed. Browser/Next.js vars and Convex backend
# vars are SEPARATE: Convex actions run in Convex's cloud environment
# and do not inherit apps/web/.env.local.
# =====================================================================

# ------------------------------ apps/web/.env.local -----------------
# Next.js + WorkOS AuthKit + Convex client
NEXT_PUBLIC_CONVEX_URL=                      # printed by `npx convex dev`
WORKOS_CLIENT_ID=                            # from WorkOS dashboard
WORKOS_API_KEY=                              # server only — NEVER NEXT_PUBLIC
WORKOS_COOKIE_PASSWORD=                      # secure random >=32 chars (SDK minimum)
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# ------------------- Convex backend env (`npx convex env set` or dashboard) ----
# MODEL PROVIDERS — provider-agnostic. AI_PROVIDER selects the default for both
# roles (generator + judge). Options:
#   openai | anthropic | deepseek | glm (aliases: zai, zhipu, chatglm)
#   openai-compatible  (any OpenAI-style API: Ollama, vLLM, Groq, OpenRouter…)
#   fake               (deterministic local model — no keys, no cost; default)
# Roles can be split across DIFFERENT providers (judge ideally a different
# model family than the generator): set CREATIVE_PROVIDER / JUDGE_PROVIDER to
# override AI_PROVIDER per role.
AI_PROVIDER=fake
# CREATIVE_PROVIDER=deepseek
# JUDGE_PROVIDER=glm

# API keys — set only the ones for providers you use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=                                # Zhipu GLM (ZHIPU_API_KEY / ZAI_API_KEY also accepted)

# Model ids (defaults: openai=gpt-5.2, anthropic=claude-sonnet-4-5,
# deepseek=deepseek-chat, glm=glm-4.6 — verify current ids with your provider)
CREATIVE_MODEL_ID=
JUDGE_MODEL_ID=

# openai-compatible gateways: base URL is required; OPENAI_API_KEY reused if set
# MODEL_BASE_URL=http://localhost:11434/v1

# Optional cost overrides (USD per 1M tokens) for spend caps/dashboard display.
# Built-in estimates exist for hosted providers; unset → cost tracked as $0 and
# budgets fall back to token/wall-clock caps.
# MODEL_COST_INPUT=
# MODEL_COST_OUTPUT=

EMBEDDING_MODEL_ID=text-embedding-3-small
JEV_API_KEY=                                # optional; Jev adapter off when unset
AGHARTA_BENCHMARK_TOKEN=                    # optional shared secret for benchmark HTTP bridge (dev only)
MAX_RUN_COST_USD=2
# AuthKit OIDC trust on Convex (auth.config.ts reads these):
WORKOS_JWT_ISSUER=https://auth.workos.com/
WORKOS_JWT_AUDIENCE=workos.authkit
WORKOS_CLIENT_ID=                           # same client ID as the web app
AGHARTA_TOKEN_HASH_KEY=                     # HMAC key for MCP token hashing (server secret)

# ------------------------------ local MCP process --------------------
AGHARTA_MCP_TOKEN=                           # user-generated token from /settings (NOT a Convex admin key)
AGHARTA_CONVEX_HTTP_URL=                     # e.g. https://<deployment>.convex.site
AGHARTA_APP_URL=http://localhost:3000
